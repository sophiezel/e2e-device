{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "dom"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "moduleResolution": "node",
    "typeRoots": [
      "../../scripts/node_modules/@types"
    ]
  },
  "include": [
    "orchestration/**/*.ts",
    "config/**/*.ts",
    "helpers/**/*.ts",
    "resilience/**/*.ts",
    "specs/**/*.ts"
  ]
}
