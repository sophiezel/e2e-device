{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "moduleResolution": "node",
    "types": ["node"]
  },
  "include": [
    "orchestration/**/*.ts",
    "config/**/*.ts",
    "helpers/**/*.ts",
    "resilience/**/*.ts"
  ]
}
