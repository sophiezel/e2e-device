{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "dom"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "5.0",
    "typeRoots": [
      "../../scripts/node_modules/@types"
    ],
    "types": ["node", "mocha"],
    "paths": {
      "@wdio/*": ["../../scripts/node_modules/@wdio/*"],
      "webdriverio": ["../../scripts/node_modules/webdriverio"]
    },
    "baseUrl": "."
  }
}
