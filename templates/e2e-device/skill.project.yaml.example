# Generated by: bash e2e-device/scripts/discover-project.sh
# Machine-readable twin: skill.project.json
id: "{{projectId}}"
projectState: C
hybrid:
  platform: android
  container:
    package: "{{appPackage}}"
    openApiActivity: "{{openApiActivity}}"
  webView:
    routingMode: history
    pathPrefix: "{{pathPrefix}}"
    hashPrefix: "/#/"
    webViewUrlAnchor: "{{webViewUrlAnchor}}"
  deepLink:
    scheme: "{{deepLinkScheme}}"
    openPath: openapi
discover:
  pagesGlob: src/pages/**/index.tsx
  envFile: src/config/env.js
  routeFile: src/App.tsx
pilot:
  domain: "{{pilotDomain}}"
